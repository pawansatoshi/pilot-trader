# --- both Vercel and Voroa worker ---
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
ALLOW_REAL=0
# --- Voroa worker only ---
OPENROUTER_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENV=            # empty = live, demo = Binance Demo Trading (recommended for validation)
# ALGO_CLOSE_MODE=qty    # qty (quantity+reduceOnly) | close (closePosition); the bot falls back to the other automatically
# SPOT_STOP_LIMIT_GAP_PCT=0.2
# --- Vercel only ---
DASH_PASSWORD=choose-a-long-password
# --- optional tuning (defaults shown) ---
# START_BALANCE=1000 RISK_PCT=1 MAX_LEVERAGE=3 MAX_POSITIONS=3 DAILY_LOSS_LIMIT_PCT=3 DAILY_TARGET_PCT=8
# SCAN_SECONDS=300 MIN_SCORE=1.5 OPENROUTER_DAILY_LIMIT=50 LLM_MIN_GAP_MIN=15 TZ_OFFSET_MIN=330
# --- risk gate (Stage 1) ---
# MIN_EFF_RR=1.5 MIN_STOP_PCT=0.3 MAX_DRIFT_ATR=0.3 MAX_EVIDENCE_AGE_SEC=240 NO_AI_POLICY=skip   (skip | rules)
